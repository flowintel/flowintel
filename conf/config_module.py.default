ORIGIN_URL = 'localhost:7006' # Used for connector, to know what's the origin of the data

# TLS verification for all MISP clients and SMTP/IMAP connections.
# True uses Requests CA defaults/environment for MISP and system SSL defaults for mail.
# For a private CA, set the relevant option to an absolute PEM CA bundle path.
# False explicitly disables certificate and hostname verification, exposing credentials
# and data to interception. Use only for controlled testing.
MISP_VERIFY_SSL = True
MAIL_VERIFY_SSL = True

# SMTP Parameters
SMTP_SERVER = ""
SMTP_PORT = 587  # Port TLS
SENDER_EMAIL = ""
SENDER_PASSOWRD = ""

# Matrix bot
MATRIX_SERVER = ""
MATRIX_USER = ""
MATRIX_PASSWORD = ""
MATRIX_ROOM_ID = ""

# Webhook
WEBHOOK_URL = ""
WEBHOOK_ENABLED = False
WEBHOOK_SECRET = ""
CASE_CREATE_ALERT_ENABLED = True

# Email IMAP (for archiving sent notifications)
IMAP_SERVER = ""
IMAP_PORT = 993
IMAP_USER = ""
IMAP_PASSWORD = ""
IMAP_USE_SSL = True

# Computer assistate Parameters
OLLAMA_URL = "http://localhost:11434"
OLLAMA_KEY = ""
OLLAMA_MODEL = ""

# Rulezet receive-from module
# Set to False only for trusted self-signed test instances; leaving it True is recommended for production.
RULEZET_VERIFY_SSL = True
